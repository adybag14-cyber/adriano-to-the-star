{
  "name": "adriano-to-the-star",
  "version": "1.0.0",
  "description": "Adriano To The Star - Explore the Cosmos",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:smoke-functional": "playwright test tests/e2e/smoke-functional.spec.js",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest --coverage",
    "lint": "eslint .",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:vite": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "format": "prettier --write \"src/**/*.{js,ts,css,html}\"",
    "type-check": "tsc --noEmit",
    "deploy:exoplanet": "npm run build:vite && wrangler pages deploy dist --project-name=exoplanet-pioneer --functions=functions --config=wrangler-exoplanet.toml",
    "deploy:exoplanet:preview": "npm run build:vite && wrangler pages deploy dist --project-name=exoplanet-pioneer --functions=functions --config=wrangler-exoplanet.toml --branch=preview",
    "local:exoplanet": "wrangler pages dev dist --functions=functions --local --config=wrangler-exoplanet.toml"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@playwright/test": "^1.40.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "babel-loader": "^9.1.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.0",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.17.0",
    "vitest": "^1.0.0",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.1",
    "webpack-cli": "^5.1.4",
    "wrangler": "^4.59.2"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@supabase/supabase-js": "^2.39.0",
    "three": "^0.160.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

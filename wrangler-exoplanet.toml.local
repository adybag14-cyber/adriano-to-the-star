name = "exoplanet-pioneer"
compatibility_date = "2024-01-01"

[env.production]
vars = { ENVIRONMENT = "production" }

[env.preview]
vars = { ENVIRONMENT = "preview" }

[env.development]
vars = { ENVIRONMENT = "development" }

# D1 Database for saves and player data
[[d1_databases]]
binding = "DB"
database_name = "exoplanet-pioneer-db"
database_id = "cd07e612-6190-4921-b538-bc88c6774519"

# KV Storage for caching and leaderboards
[[kv_namespaces]]
binding = "CACHE"
id = "0206e446492a46cdbf5a3871830b9ea2"

# Durable Objects for real-time multiplayer
[[durable_objects.bindings]]
name = "GAME_ROOM"
class_name = "GameRoom"
script_name = "game-room-worker"

[build]
command = "npm run build:vite"
cwd = "."
watch_dir = "src"

[build.upload]
format = "modules"
main = "./_worker.js"
rules = [
  { type = "ESModule", globs = ["**/*.js"], fallthrough = true }
]

# Environment variables (use wrangler secret put for sensitive values)
[vars]
GAME_VERSION = "1.0.0"
API_BASE_URL = "/api"
